# ============================
# 🌱 Flask Core
# ============================
ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key

# The port Flask will run on
PORT=5000

# ============================
# 💾 Database
# ============================
# SQLAlchemy connection string (supports sqlite, postgres, etc.)
DATABASE_URL=sqlite:////app/data/mindsetbackend.db

# If your startup script handles this flag
SQLITE_CREATE_IF_MISSING=true

# Log SQL statements to the console (true/false)
SQL_ECHO=false

# ============================
# 👤 Superuser Setup (for bootstrapping)
# ============================
RUN_MIGRATIONS_ON_START=true
CREATE_SUPERUSER_ON_BOOT=true


# ============================
# 👤 Refrence Seed Setup (for bootstrapping)
# ============================
# If true, run reference data seed at startup: `flask cli db seed`
# Set to `true` to populate lookup/reference tables during container init.
RUN_SEEDS_ON_START=false

SUPERUSER_EMAIL=admin@example.com
SUPERUSER_NAME=Admin
SUPERUSER_PASSWORD=yourpassword

# ============================
# 🔐 JWT Settings
# ============================
# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRES=120


# ============================
# 🌐 Allowed frontend URLs (for CORS)
# ============================
FRONTEND_URLS=["http://localhost:5173","https://myapp.com"]
